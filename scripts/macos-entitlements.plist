<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- TCC still prompts the user. This entitlement is needed when audio capture is
       used by a hardened Developer ID build. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- EventKit calendar access for pre-meeting recording suggestions. TCC
       still presents the user consent prompt. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>

</dict>
</plist>

{
  "name": "stenly-site",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i assets/site.css -o static/site.css --minify",
    "css:watch": "tailwindcss -i assets/site.css -o static/site.css --watch",
    "build": "npm run css && zola build",
    "build:pages": "npm run css && zola build",
    "deploy:pages": "npm run build:pages && npx wrangler pages deploy public --project-name stenly-site --branch main",
    "dev": "node scripts/dev.mjs",
    "check": "npm run css && zola check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "4.1.18",
    "wrangler": "4.152.0",
    "tailwindcss": "4.1.18"
  }
}
